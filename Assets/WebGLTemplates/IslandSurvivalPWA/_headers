/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.json
  Cache-Control: no-cache
/Build/*.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: no-cache
/Build/*.js.br
  Content-Type: application/javascript
  Content-Encoding: br
  Cache-Control: no-cache
/Build/*.data.br
  Content-Type: application/octet-stream
  Content-Encoding: br
  Cache-Control: no-cache
